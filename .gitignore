# EcoFix — Git Ignore Rules

# ── Secrets ──────────────────────────────────────────────────
.env
.env.local
.env.*.local
android/local.properties
android/app/google-services.json
supabase/functions/.env

# ── Node / Next.js ────────────────────────────────────────────
node_modules/
.next/
out/
build/
web/.next/
web/node_modules/

# ── Android ───────────────────────────────────────────────────
android/.gradle/
android/build/
android/app/build/
android/captures/
android/**/*.iml
android/.idea/
android/keystore/
*.jks
*.keystore

# ── Supabase local ────────────────────────────────────────────
supabase/.temp/
supabase/seed.sql.tmp

# ── IDE / OS ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/settings.json

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*

# ── Python / Test Artifacts ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
gh-pages/
temp-artifacts/

web/.env*
*.whl
