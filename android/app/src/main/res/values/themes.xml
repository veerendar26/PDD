<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- EcoFix brand dark theme -->
    <style name="Theme.EcoFix" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface0</item>
        <item name="android:statusBarColor">@color/surface0</item>
        <item name="android:navigationBarColor">@color/surface0</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Splash theme (fullscreen while app loads) -->
    <style name="Theme.EcoFix.Splash" parent="Theme.EcoFix">
        <item name="android:windowSplashScreenBackground">@color/surface0</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
